[Unit]
Description=Bounded local database recovery snapshots
After=gitea.service

[Service]
Type=oneshot
User=git
Group=git
EnvironmentFile=/etc/gitea/github-archive.env
ExecStart=/usr/local/lib/github-archive/archive.py snapshot
UMask=0077
Nice=15
MemoryMax=100M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/github-archive
