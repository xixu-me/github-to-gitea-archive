# Copy to /etc/gitea/github-archive.env, owned by root:git with mode 0640.
# Values are literal. Quote spaces; do not use shell substitutions.
GITHUB_OWNER=your-github-account
GITHUB_ACCOUNT_TYPE=auto
# A separate Gitea organization or user is supported; defaults to GITHUB_OWNER.
# GITEA_OWNER=archive
# The dashboard and hook pusher must be a real Gitea user, not an organization.
# ARCHIVE_ADMIN_USER=maintainer
GITEA_URL=http://127.0.0.1:3000
GITEA_TOKEN=
ARCHIVE_PUBLIC_URL=https://git.example.com
# App authentication is preferred. Use a read-only PAT instead for token mode.
GITHUB_TOKEN=
# Required for signed webhooks in PAT mode; the App flow writes its own secret.
WEBHOOK_SECRET=
ARCHIVE_ROOT=/var/lib/github-archive
ARCHIVE_PORT=3091
GITEA_REPO_ROOT=/var/lib/gitea/repositories
GITEA_DB_PATH=/var/lib/gitea/data/gitea.db
GITEA_CUSTOM_DIR=/var/lib/gitea/custom
ARCHIVE_MIN_FREE_MIB=500
ARCHIVE_NORMAL_FREE_MIB=1536
ARCHIVE_SNAPSHOT_BUDGET_MIB=512
# Optional custom App name (1-34 characters); otherwise derived from the account.
# GITHUB_APP_NAME='Example GitHub Archive'
# Colon-separated absolute configuration files, not directories.
ARCHIVE_SNAPSHOT_PATHS=/etc/nginx/sites-enabled/git.example.com
